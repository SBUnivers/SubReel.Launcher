<Application x:Class="SubReel.Launcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SubReel.Launcher.App.ViewModels"
             xmlns:views="clr-namespace:SubReel.Launcher.App.Views"
             ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
                <ResourceDictionary Source="Resources/Locales/ru-RU.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <DataTemplate DataType="{x:Type vm:SectionViewModel}">
                <views:SectionView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
                <views:InstancesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RustClientsViewModel}">
                <views:RustClientsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModsCatalogViewModel}">
                <views:ModsCatalogView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NewsViewModel}">
                <views:NewsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DesignSystemViewModel}">
                <views:DesignSystemView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
