<Application x:Class="SubReel.Launcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SubReel.Launcher.App.ViewModels"
             xmlns:views="clr-namespace:SubReel.Launcher.App.Views"
             ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:SectionViewModel}">
                <views:SectionView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
                <views:InstancesView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
