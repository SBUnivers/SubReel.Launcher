<UserControl x:Class="SubReel.Launcher.App.Views.RustClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="clr-namespace:SubReel.Launcher.App.DesignSystem">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Content="{DynamicResource Rust.Refresh}" Command="{Binding LoadCommand}" Padding="14,8"/>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Rust.Eyebrow}" Foreground="{DynamicResource AccentBrush}" FontSize="{design:ScaledFontSize 11}" FontWeight="Bold"/>
                    <TextBlock Text="{DynamicResource Rust.Title}" Foreground="{DynamicResource TextPrimary}" FontSize="{design:ScaledFontSize 30}" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="{DynamicResource Rust.Description}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="190"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" DisplayMemberPath="DisplayVersion" Padding="10,8" AutomationProperties.Name="{DynamicResource Rust.Release}"/>
                    <TextBox Grid.Column="2" Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" ToolTip="{DynamicResource Rust.InstanceName}"/>
                    <Button Grid.Column="4" Content="{DynamicResource Rust.Install}" Command="{Binding InstallCommand}" Padding="18,9"/>
                </Grid>
            </Border>
            <Grid x:Name="PanelsGrid" Grid.Row="2" SizeChanged="OnPanelsSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <Border x:Name="ReleasePanel" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Rust.Releases}" Foreground="{DynamicResource TextPrimary}" FontSize="{design:ScaledFontSize 17}" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Rust.ReleaseHint}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                        <ListBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" Background="Transparent" BorderThickness="0" MinHeight="190">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="12" Margin="0,3">
                                    <DockPanel><TextBlock Text="{Binding PublishedAt, StringFormat={}{0:dd.MM.yyyy}}" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding DisplayVersion}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="{Binding Tag}" Foreground="{DynamicResource TextSecondary}" Margin="10,0,0,0"/></DockPanel>
                                </Border>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Border x:Name="InstancePanel" Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Rust.Instances}" Foreground="{DynamicResource TextPrimary}" FontSize="{design:ScaledFontSize 17}" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Rust.InstanceHint}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                        <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Background="Transparent" BorderThickness="0" MinHeight="150">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="12" Margin="0,3">
                                    <StackPanel><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="{Binding ReleaseTag}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/></StackPanel>
                                </Border>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBox Text="{Binding SelectedInstanceName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,12,0,8" ToolTip="{DynamicResource Rust.RenameHint}"/>
                        <Button Content="{DynamicResource Rust.Rename}" Command="{Binding RenameInstanceCommand}" Padding="12,8" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Content="{DynamicResource Rust.Delete}" Command="{Binding DeleteInstanceCommand}" Padding="12,8" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,12,0,8" ToolTip="{DynamicResource Rust.Username}"/>
                        <Button Content="{DynamicResource Rust.Play}" Command="{Binding LaunchCommand}" Padding="18,11" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/><Button DockPanel.Dock="Right" Content="{DynamicResource Rust.Cancel}" Command="{Binding CancelInstallCommand}" Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="10,5"/></DockPanel>
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="5" Margin="0,10,0,0" Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
