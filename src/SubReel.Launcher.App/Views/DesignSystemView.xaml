<UserControl x:Class="SubReel.Launcher.App.Views.DesignSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:SubReel.Launcher.App.DesignSystem" xmlns:design="clr-namespace:SubReel.Launcher.App.DesignSystem">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="{DynamicResource DesignSystem.Title}" FontSize="{design:ScaledFontSize 30}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{DynamicResource DesignSystem.Description}" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,24"/>
            <Border Style="{StaticResource CardStyle}" MaxWidth="900" HorizontalAlignment="Left" motion:MotionBehaviors.FadeIn="True">
                <StackPanel>
                    <TextBlock Text="{DynamicResource DesignSystem.AccentColor}" FontSize="{design:ScaledFontSize 18}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,24">
                        <Button Content="{DynamicResource DesignSystem.Violet}" Command="{Binding UseVioletCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource DesignSystem.Cyan}" Command="{Binding UseCyanCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource DesignSystem.Amber}" Command="{Binding UseAmberCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource DesignSystem.ButtonsStates}" FontSize="{design:ScaledFontSize 18}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <WrapPanel Margin="0,12,0,24">
                        <Button Content="{DynamicResource DesignSystem.Primary}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                        <Button Content="{DynamicResource DesignSystem.Secondary}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                        <Button Content="{DynamicResource DesignSystem.Disabled}" IsEnabled="False" Margin="0,0,8,8"/>
                        <Button ToolTip="{DynamicResource DesignSystem.VectorIconExample}" Style="{StaticResource IconButton}" Margin="0,0,8,8"><Path Data="{StaticResource IconSearchGeometry}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                        <ToggleButton Content="Vanilla" Style="{StaticResource ChipToggle}" IsChecked="True" Margin="0,0,8,8"/>
                        <ToggleButton Content="Fabric" Style="{StaticResource ChipToggle}" Margin="0,0,8,8"/>
                        <ToggleButton Content="NeoForge" Style="{StaticResource ChipToggle}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource DesignSystem.Forms}" FontSize="{design:ScaledFontSize 18}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <Grid Margin="0,12,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="{DynamicResource DesignSystem.InputField}"/>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Margin="5,0"><ComboBoxItem Content="Minecraft 1.21.1"/><ComboBoxItem Content="Minecraft 1.20.1"/></ComboBox>
                        <CheckBox Grid.Column="2" Content="{DynamicResource DesignSystem.EnableOption}" IsChecked="True" Margin="12,8"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource DesignSystem.Memory}" Foreground="{DynamicResource TextSecondary}"/>
                    <Slider Minimum="512" Maximum="16384" Value="4096"/>
                    <ProgressBar Value="{Binding SampleProgress}" Maximum="100" Margin="0,8,0,24"/>
                    <TextBlock Text="{DynamicResource DesignSystem.Motion}" FontSize="{design:ScaledFontSize 18}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <CheckBox Content="{DynamicResource DesignSystem.ReduceMotion}" IsChecked="{Binding ReducedMotion, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"/>
                    <ItemsControl ItemsSource="{Binding SampleItems}" motion:MotionBehaviors.Stagger="True" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Width="180" Margin="0,0,10,10" motion:MotionBehaviors.HoverLift="True"><StackPanel><TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource DesignSystem.HoverHint}" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="12" Background="{DynamicResource CardRaisedBackground}" CornerRadius="6" motion:MotionBehaviors.Shimmer="True" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
