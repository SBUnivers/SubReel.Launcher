<Window x:Class="SubReel.Launcher.App.Views.ErrorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ошибка SubReel Launcher" Width="680" Height="440"
        WindowStartupLocation="CenterOwner" Background="#111019" Foreground="{DynamicResource TextPrimary}"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Произошла ошибка" FontSize="24" FontWeight="Bold"/><TextBlock Text="Диагностику можно скопировать и отправить разработчикам." Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,16"/></StackPanel>
        <TextBox x:Name="Details" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Background="#191725" Foreground="{DynamicResource TextPrimary}" BorderBrush="#383348" Padding="12"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Скопировать диагностику" Click="Copy_Click" Padding="14,8" Margin="0,0,10,0"/>
            <Button Content="Закрыть" Click="Close_Click" Padding="18,8" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
