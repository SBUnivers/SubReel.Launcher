<UserControl x:Class="SubReel.Launcher.App.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:SubReel.Launcher.App.Views.Components">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Игровые сборки"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Text="Создавай и настраивай отдельные профили Minecraft."
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,8,0,24"/>

            <Grid x:Name="InstancesLayout" SizeChanged="OnInstancesLayoutSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Список сохранённых сборок -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18">

                    <StackPanel>
                        <DockPanel Margin="0,0,0,14" LastChildFill="False">
                            <Button Content="Обновить"
                                    Command="{Binding LoadCommand}"
                                    DockPanel.Dock="Right"
                                    Padding="10,6"/>
                            <TextBlock Text="Мои сборки"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>

                        </DockPanel>

                        <ListBox ItemsSource="{Binding Instances}"
                                 SelectedItem="{Binding SelectedInstance}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 HorizontalContentAlignment="Stretch"
                                 MinHeight="250">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <components:InstanceCard
                                        FavoriteCommand="{Binding DataContext.ToggleFavoriteCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Выбери сборку, чтобы изменить её настройки."
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Создание и редактирование -->
                <StackPanel x:Name="EditorPanel" Grid.Column="2">
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Новая сборка"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Название"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding InstanceName,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,12"
                                     Padding="9"/>

                            <TextBlock Text="Версия Minecraft"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding MinecraftVersion,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,12"
                                     Padding="9"/>

                            <TextBlock Text="Загрузчик"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <ComboBox ItemsSource="{Binding LoaderTypes}"
                                      SelectedItem="{Binding SelectedLoader}"
                                      Margin="0,6,0,12"
                                      Padding="7"/>

                            <TextBlock Text="Версия загрузчика (если нужна)"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding LoaderVersion,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,12"
                                     Padding="9"/>

                            <TextBlock Text="Память, МБ"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding MemoryMbInput,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,16"
                                     Padding="9"/>

                            <Button Content="＋  Создать сборку"
                                    Command="{Binding CreateCommand}"
                                    Padding="12"
                                    HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18"
                            Margin="0,16,0,0">

                        <StackPanel>
                            <TextBlock Text="Выбранная сборка"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="Имя игрока (офлайн)"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,14"
                                     Padding="9"/>

                            <TextBlock Text="Название"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding SelectedInstance.Name,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding HasSelection}"
                                     Margin="0,6,0,12"
                                     Padding="9"/>

                            <TextBlock Text="Версия Minecraft"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding SelectedInstance.MinecraftVersion,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding HasSelection}"
                                     Margin="0,6,0,12"
                                     Padding="9"/>

                            <TextBlock Text="Память, МБ"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding SelectedInstance.MemoryMb,
                                        UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding HasSelection}"
                                     Margin="0,6,0,16"
                                     Padding="9"/>

                            <Button Content="Сохранить изменения"
                                    Command="{Binding SaveSelectedCommand}"
                                    Margin="0,0,0,8"
                                    Padding="10"/>

                            <Button Content="Удалить запись"
                                    Command="{Binding DeleteSelectedCommand}"
                                    Padding="10"/>

                            <Button Content="▶  Запустить игру"
                                    Command="{Binding LaunchSelectedCommand}"
                                    IsEnabled="{Binding HasSelection}"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,10,0,0"
                                    Padding="12"/>
                            <ProgressBar Value="{Binding LaunchProgress}"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,10,0,0"
                                         Visibility="{Binding IsLaunching,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="Отменить запуск"
                                    Command="{Binding CancelLaunchCommand}"
                                    Visibility="{Binding IsLaunching, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource CardRaisedBackground}"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,16,0,0">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
