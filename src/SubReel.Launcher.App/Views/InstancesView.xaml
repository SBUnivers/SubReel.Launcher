<UserControl x:Class="SubReel.Launcher.App.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:SubReel.Launcher.App.Views.Components"
             xmlns:views="clr-namespace:SubReel.Launcher.App.Views" xmlns:design="clr-namespace:SubReel.Launcher.App.DesignSystem">
    <UserControl.Resources>
        <views:BooleanInverseConverter x:Key="BooleanInverseConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="{DynamicResource Instances.Title}"
                       Style="{StaticResource DisplayTextStyle}"
                       FontSize="{design:ScaledFontSize 30}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Text="{DynamicResource Instances.Subtitle}"
                       FontSize="{design:ScaledFontSize 14}"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,8,0,24"/>

            <Grid x:Name="InstancesLayout" SizeChanged="OnInstancesLayoutSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Список сохранённых сборок -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18">

                    <StackPanel>
                        <DockPanel Margin="0,0,0,14" LastChildFill="False">
                            <Button Content="{DynamicResource Instances.Refresh}"
                                    Command="{Binding LoadCommand}"
                                    DockPanel.Dock="Right"
                                    Padding="10,6"/>
                            <TextBlock Text="{DynamicResource Instances.Mine}"
                                       FontSize="{design:ScaledFontSize 18}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>

                        </DockPanel>

                        <Grid x:Name="InstanceFilters" Margin="0,0,0,10" SizeChanged="OnInstanceFiltersSizeChanged">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstanceSearchBox" Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource Instances.Search}"
                                     Padding="9,7"/>
                            <ComboBox x:Name="InstanceSortBox" Grid.Column="2"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedSortOption}"
                                      Padding="7,6"
                                      ToolTip="{DynamicResource Instances.Sort}">
                                <ComboBoxItem Content="{DynamicResource Instances.SortName}" Tag="name"/>
                                <ComboBoxItem Content="{DynamicResource Instances.SortRecent}" Tag="recent"/>
                                <ComboBoxItem Content="{DynamicResource Instances.SortFavorite}" Tag="favorite"/>
                            </ComboBox>
                        </Grid>

                        <ListBox ItemsSource="{Binding FilteredInstances}"
                                 SelectedItem="{Binding SelectedInstance}"
                                 AutomationProperties.Name="{DynamicResource Instances.ListName}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 HorizontalContentAlignment="Stretch"
                                 MinHeight="250">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                    <components:InstanceCard AutomationProperties.Name="{Binding Name}"
                                        FavoriteCommand="{Binding DataContext.ToggleFavoriteCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <components:EmptyStateCard Title="{DynamicResource Instances.EmptyTitle}"
                                                   Message="{Binding EmptyStateText}"
                                                   IconKey="instances"
                                                   Margin="0,10,0,0">
                            <components:EmptyStateCard.Style>
                                <Style TargetType="components:EmptyStateCard">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasInstances}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasSearchNoResults}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </components:EmptyStateCard.Style>
                        </components:EmptyStateCard>

                        <TextBlock Text="{DynamicResource Instances.SelectHint}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Создание и редактирование -->
                <StackPanel x:Name="EditorPanel" Grid.Column="2">
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Instances.New}"
                                       FontSize="{design:ScaledFontSize 18}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="{DynamicResource Instances.Name}"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding InstanceName,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,12"
                                     Padding="9"/>

                            <TextBlock Text="{DynamicResource Instances.MinecraftVersion}"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding MinecraftVersion,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,12"
                                     Padding="9"/>

                            <TextBlock Text="{DynamicResource Instances.Loader}"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <ComboBox ItemsSource="{Binding LoaderTypes}"
                                      SelectedItem="{Binding SelectedLoader}"
                                      Margin="0,6,0,12"
                                      Padding="7"/>

                            <TextBlock Text="{DynamicResource Instances.LoaderVersionOptional}"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding LoaderVersion,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,12"
                                     Padding="9"/>

                            <TextBlock Text="{DynamicResource Instances.Memory}"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding MemoryMbInput,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,4"
                                     Padding="9"/>
                            <components:MemoryAllocationControl Value="{Binding MemoryMbInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                AutomationLabel="{DynamicResource Instances.NewMemoryAutomation}"
                                                                Margin="0,0,0,14"/>

                            <Button Content="{DynamicResource Instances.Create}"
                                    Command="{Binding CreateCommand}"
                                    Padding="12"
                                    HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18"
                            Margin="0,16,0,0">

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Instances.Selected}"
                                       FontSize="{design:ScaledFontSize 18}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="{DynamicResource Instances.PlayerName}"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,14"
                                     Padding="9"/>

                            <TextBlock Text="{DynamicResource Instances.Name}"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding SelectedInstance.Name,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding HasSelection}"
                                     Margin="0,6,0,12"
                                     Padding="9"/>

                            <TextBlock Text="{DynamicResource Instances.MinecraftVersion}"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding SelectedInstance.MinecraftVersion,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding HasSelection}"
                                     Margin="0,6,0,12"
                                     Padding="9"/>

                            <TextBlock Text="{DynamicResource Instances.Loader}"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox ItemsSource="{Binding LoaderTypes}"
                                      SelectedItem="{Binding SelectedInstance.LoaderType, Mode=TwoWay}"
                                      IsEnabled="{Binding HasSelection}"
                                      Margin="0,6,0,4"
                                      Padding="7"/>
                            <TextBlock Text="{DynamicResource Instances.LoaderHelp}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{design:ScaledFontSize 11}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBox Text="{Binding SelectedInstance.LoaderVersion, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding HasSelection}"
                                     ToolTip="{DynamicResource Instances.LoaderTooltip}"
                                     Margin="0,0,0,12"
                                     Padding="9"/>

                            <TextBlock Text="{DynamicResource Instances.Memory}"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox Text="{Binding SelectedInstance.MemoryMb,
                                        UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding HasSelection}"
                                      Margin="0,6,0,4"
                                     Padding="9"/>
                            <components:MemoryAllocationControl Value="{Binding SelectedInstance.MemoryMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                AutomationLabel="{DynamicResource Instances.SelectedMemoryAutomation}"
                                                                IsEnabled="{Binding HasSelection}"
                                                                Margin="0,0,0,14"/>

                            <TextBlock Text="{DynamicResource Instances.JavaPath}"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Text="{Binding SelectedInstance.JavaPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding HasSelection}"
                                     ToolTip="{DynamicResource Instances.JavaTooltip}"
                                     Margin="0,6,0,8"
                                     Padding="9"/>
                            <Button Content="{DynamicResource Instances.CheckJava}"
                                    Command="{Binding InspectJavaCommand}"
                                    IsEnabled="{Binding HasSelection}"
                                    Margin="0,0,0,12"
                                    Padding="9"/>

                            <Button Content="{DynamicResource Instances.Save}"
                                    Command="{Binding SaveSelectedCommand}"
                                    Margin="0,0,0,8"
                                    Padding="10"/>

                            <Button Content="{DynamicResource Instances.Delete}"
                                    Command="{Binding DeleteSelectedCommand}"
                                    Padding="10"/>

                            <Button Content="{DynamicResource Instances.Duplicate}"
                                    Command="{Binding DuplicateSelectedCommand}"
                                    IsEnabled="{Binding HasSelection}"
                                    Margin="0,8,0,0"
                                    Padding="10"/>

                            <Border Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsDuplicateOptionsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Instances.CopyDataTitle}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <CheckBox Content="{DynamicResource Instances.CopySaves}" IsChecked="{Binding CopySaves}" Margin="0,3"/>
                                    <CheckBox Content="{DynamicResource Instances.CopyGameOptions}" IsChecked="{Binding CopyGameOptions}" Margin="0,3"/>
                                    <CheckBox Content="{DynamicResource Instances.CopyResourcePacks}" IsChecked="{Binding CopyResourcePacks}" Margin="0,3"/>
                                    <CheckBox Content="{DynamicResource Instances.CopyShaderPacks}" IsChecked="{Binding CopyShaderPacks}" Margin="0,3"/>
                                    <CheckBox Content="{DynamicResource Instances.CopyScreenshots}" IsChecked="{Binding CopyScreenshots}" Margin="0,3"/>
                                    <CheckBox Content="{DynamicResource Instances.CopyServers}" IsChecked="{Binding CopyServers}" Margin="0,3"/>
                                    <CheckBox Content="{DynamicResource Instances.CopyMods}" IsChecked="{Binding CopyMods}" Margin="0,3,0,8"/>
                                    <Button Content="{DynamicResource Instances.CreateCopy}"
                                            Command="{Binding CreateDuplicateCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}"
                                            Background="{DynamicResource AccentBrush}"
                                            Padding="9,6"/>
                                    <Button Content="{DynamicResource Instances.CancelCopy}"
                                            Command="{Binding CancelDuplicateCommand}"
                                            Margin="0,6,0,0"
                                            Padding="9,6"/>
                                </StackPanel>
                            </Border>

                            <Button Content="{DynamicResource Instances.OpenFolder}"
                                    Command="{Binding OpenSelectedFolderCommand}"
                                    IsEnabled="{Binding HasSelection}"
                                    Margin="0,8,0,0"
                                    Padding="10"/>

                            <Button Content="{DynamicResource Instances.Export}"
                                    Command="{Binding ExportSelectedManifestCommand}"
                                    IsEnabled="{Binding HasSelection}"
                                    Margin="0,8,0,0"
                                    Padding="10"/>

                            <Button Content="{DynamicResource Instances.Import}"
                                    Command="{Binding ImportModpackManifestCommand}"
                                    Margin="0,8,0,0"
                                    Padding="10"/>

                            <Button Content="{DynamicResource Instances.Launch}"
                                    Command="{Binding LaunchSelectedCommand}"
                                    IsEnabled="{Binding HasSelection}"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,10,0,0"
                                    Padding="12"/>
                            <ProgressBar Value="{Binding LaunchProgress}"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,10,0,0"
                                         Visibility="{Binding IsLaunching,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="{DynamicResource Instances.Cancel}"
                                    Command="{Binding CancelLaunchCommand}"
                                    Visibility="{Binding IsLaunching, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,16,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Instances.Mods.Title}"
                                       Style="{StaticResource DisplayTextStyle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Instances.Mods.Subtitle}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,10"/>
                            <DockPanel>
                                <Button Content="{DynamicResource Instances.Mods.SearchButton}"
                                        Command="{Binding SearchInstanceModsCommand}"
                                        IsEnabled="{Binding IsModManagerBusy, Converter={StaticResource BooleanInverseConverter}}"
                                        DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Padding="10,6"/>
                                <TextBox Text="{Binding ModSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Instances.Mods.SearchHint}"
                                         Padding="9,7"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding ModProviders}"
                                      SelectedItem="{Binding SelectedModProvider, Mode=TwoWay}"
                                      Margin="0,8,0,2"
                                      Padding="7"
                                      ToolTip="{DynamicResource Instances.Mods.Provider}"/>
                            <TextBlock Text="{Binding ModManagerStatus}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,4"/>
                            <ProgressBar IsIndeterminate="True"
                                         Height="4"
                                         Margin="0,0,0,8"
                                         Visibility="{Binding IsModManagerBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="{DynamicResource Instances.Mods.CancelButton}"
                                    Command="{Binding CancelModManagerOperationCommand}"
                                    Visibility="{Binding IsModManagerBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,0,8"
                                    Padding="8,5"/>

                            <DockPanel Margin="0,4,0,6">
                                <Button Content="{DynamicResource Instances.Mods.CheckUpdatesButton}"
                                        Command="{Binding CheckInstanceModUpdatesCommand}"
                                        IsEnabled="{Binding IsModManagerBusy, Converter={StaticResource BooleanInverseConverter}}"
                                        DockPanel.Dock="Right"
                                        Padding="8,5"/>
                                <TextBlock Text="{DynamicResource Instances.Mods.InstalledHeader}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding InstalledMods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardRaisedBackground}"
                                                CornerRadius="8"
                                                Padding="8"
                                                Margin="0,3">
                                            <DockPanel LastChildFill="True">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Button Content="{DynamicResource Instances.Mods.UpdateButton}"
                                                            Command="{Binding DataContext.UpdateInstanceModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.IsModManagerBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanInverseConverter}}"
                                                            Margin="4,0,0,0" Padding="7,4">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.ToggleInstanceModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.IsModManagerBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanInverseConverter}}"
                                                            Margin="4,0,0,0" Padding="7,4">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Content" Value="{DynamicResource Instances.Mods.DisableButton}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Content" Value="{DynamicResource Instances.Mods.EnableButton}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="{DynamicResource Instances.Mods.RemoveButton}"
                                                            Command="{Binding DataContext.RemoveInstanceModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.IsModManagerBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanInverseConverter}}"
                                                            Margin="4,0,0,0" Padding="7,4"/>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SizeBytes, StringFormat={}{0:N0} B}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource Instances.Mods.SearchResultsHeader}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,6"/>
                            <ItemsControl ItemsSource="{Binding ModSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardRaisedBackground}"
                                                CornerRadius="8"
                                                Padding="9"
                                                Margin="0,3">
                                            <DockPanel LastChildFill="True">
                                                <Button Content="{DynamicResource Instances.Mods.InstallButton}"
                                                        Command="{Binding DataContext.InstallInstanceModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsModManagerBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanInverseConverter}}"
                                                        DockPanel.Dock="Right"
                                                        Margin="8,0,0,0"
                                                        Padding="8,5"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="40"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource CardRaisedBackground}"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,16,0,0">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
