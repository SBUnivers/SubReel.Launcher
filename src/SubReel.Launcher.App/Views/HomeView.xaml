<UserControl x:Class="SubReel.Launcher.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SubReel.Launcher.App.ViewModels"
             xmlns:views="clr-namespace:SubReel.Launcher.App.Views">
    <UserControl.Resources>
        <views:BooleanInverseConverter x:Key="BooleanInverseConverter"/>
        <Style x:Key="ReleaseCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Card" CornerRadius="24" BorderThickness="1" BorderBrush="#2AFFFFFF" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <Grid>
                            <Image Source="{Binding ArtUri}" Stretch="UniformToFill" Opacity="0.55" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border Background="{DynamicResource AccentBrush}" Opacity="0.24"/>
                            <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#100A0D16" Offset="0"/><GradientStop Color="#B80A0D16" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                            <Ellipse Width="210" Height="210" Fill="#22FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-55,-75,0"/>
                            <Ellipse Width="160" Height="160" Fill="#18FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-30,-50"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="22">
                                <TextBlock Text="{Binding Tagline}" FontSize="10" FontWeight="Bold" Foreground="#C9FFFFFF"/>
                                <TextBlock Text="{Binding Id}" FontSize="58" FontWeight="ExtraBold" Foreground="White" Margin="-3,3,0,-4"/>
                                <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LatestVersionLabel}" FontSize="11" Foreground="#D8FFFFFF" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Card" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.38"/></Setter.Value></Setter>
                        </Trigger>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter"><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard></EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave"><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard></EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VersionOption" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="#12111B"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="OptionBorder" Background="{TemplateBinding Background}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource CardRaisedBackground}"/><Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LoaderChip" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="#282633" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource CardRaisedBackground}"/><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Root" Margin="28" ClipToBounds="True">
        <Grid x:Name="BrowseLayer" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="ТВОЯ СЛЕДУЮЩАЯ ИСТОРИЯ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Выбери версию" FontSize="34" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,7,0,0"/>
                <TextBlock Text="Релизы и снимки из официального манифеста Minecraft." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" Margin="0,20,0,12"/>
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="2,4,2,18">
                <ItemsControl ItemsSource="{Binding Families}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,14,0"/></Style></ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate><DataTemplate DataType="vm:MinecraftReleaseFamily">
                        <Button Style="{StaticResource ReleaseCardButton}" Tag="{Binding Accent}" Command="{Binding DataContext.SelectFamilyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="216" Height="350"/>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="3" Background="#171522" BorderBrush="{DynamicResource CardRaisedBackground}" BorderThickness="1" CornerRadius="14" Padding="16,12">
                <DockPanel><Button DockPanel.Dock="Right" Content="Обновить манифест" Command="{Binding RefreshVersionsCommand}" Padding="12,7"/><TextBlock Text="{Binding VersionCatalogStatus}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/></DockPanel>
            </Border>
        </Grid>

        <Grid x:Name="DetailLayer" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform Y="16"/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="← Назад" Command="{Binding GoBackCommand}" Padding="12,8" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding SelectedFamily.Name}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedFamily.Id}" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,2,0,0"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,22,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="26" Background="#14131E" BorderBrush="{DynamicResource CardRaisedBackground}" BorderThickness="1"/>
                <Grid Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True">
                    <Ellipse Width="440" Height="440" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-100,0" Fill="{DynamicResource AccentBrush}" Opacity="0.11"/>
                    <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,170,-145" Fill="{DynamicResource AccentBrush}" Opacity="0.07"/>
                </Grid>
                <StackPanel Grid.Column="0" Margin="24">
                    <TextBlock Text="ВЕРСИЯ MINECRAFT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Точная версия" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,5,0,14"/>
                    <ListBox x:Name="ExactVersionList" ItemsSource="{Binding ExactVersions}" SelectedValuePath="Id" SelectedValue="{Binding SelectedVersion, Mode=TwoWay}" ItemContainerStyle="{StaticResource VersionOption}" Background="Transparent" BorderThickness="0" MaxHeight="360">
                        <ListBox.ItemTemplate><DataTemplate><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="7,3" Margin="0,0,5,0" Visibility="{Binding IsLatest, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="LATEST" FontSize="8" Foreground="#100D19" FontWeight="Bold"/></Border><Border Background="#27243A" CornerRadius="8" Padding="7,3" Margin="0,0,5,0" Visibility="{Binding IsSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="SNAPSHOT" FontSize="8" Foreground="{DynamicResource AccentBrush}"/></Border><Border Background="#34303F" CornerRadius="8" Padding="7,3" Visibility="{Binding IsLegacy, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ChannelLabel}" FontSize="8" Foreground="{DynamicResource TextSecondary}"/></Border></StackPanel><TextBlock Text="{Binding Id}" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,24,24,24" VerticalAlignment="Center">
                    <TextBlock Text="СБОРКА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <ComboBox ItemsSource="{Binding Instances}"
                              SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Background="#171522"
                              Foreground="{StaticResource TextPrimary}"
                              BorderBrush="#3AFFFFFF"
                              Padding="8,6"
                              Margin="0,7,0,12"
                              ToolTip="Выбери сохранённую сборку. Если не выбирать, лаунчер подберёт или создаст сборку для выбранной версии."/>
                    <TextBlock Text="ЗАПУСТИТЬ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Выбери загрузчик" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,5,0,18"/>
                    <ListBox ItemsSource="{Binding LoaderOptions}" SelectedValuePath="Id" SelectedValue="{Binding SelectedLoader, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionMode="Single">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource LoaderChip}"><Setter Property="IsEnabled" Value="{Binding IsAvailable}"/><Setter Property="ToolTip" Value="{Binding AvailabilityMessage}"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextSecondary}" FontSize="9" Margin="6,1,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding LoaderCatalogStatus}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedVersionSummary}" Foreground="{StaticResource TextSecondary}" Margin="0,20,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1">
                    <Button Command="{Binding PlayCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}" MinWidth="180" Padding="25,16" Background="{DynamicResource AccentBrush}" BorderThickness="0" FontSize="16" FontWeight="Bold">
                        <Button.Content><Grid MinWidth="130">
                            <TextBlock Text="Играть" Foreground="#100D19" HorizontalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}"/>
                            <TextBlock Text="Подготовка…" Foreground="#100D19" HorizontalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ProgressBar Value="{Binding LaunchProgress}" Maximum="100" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-10" Foreground="#100D19" Background="#55200F40" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid></Button.Content>
                    </Button>
                    <Button Content="Отменить запуск" Command="{Binding CancelLaunchCommand}" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
