<UserControl x:Class="SubReel.Launcher.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SubReel.Launcher.App.ViewModels"
             xmlns:views="clr-namespace:SubReel.Launcher.App.Views"
             xmlns:design="clr-namespace:SubReel.Launcher.App.DesignSystem">
    <UserControl.Resources>
        <views:BooleanInverseConverter x:Key="BooleanInverseConverter"/>
        <Style x:Key="ReleaseCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="design:MotionBehaviors.HoverLift" Value="True"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Card" CornerRadius="24" BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ArtUri}" Stretch="UniformToFill" Opacity="0.55" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border Background="{DynamicResource AccentBrush}" Opacity="0.24"/>
                            <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#100A0D16" Offset="0"/><GradientStop Color="#B80A0D16" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                            <Ellipse Width="210" Height="210" Fill="{DynamicResource ArtworkHighlightBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-55,-75,0"/>
                            <Ellipse Width="160" Height="160" Fill="{DynamicResource GlassBorderSubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-30,-50"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="22">
                                <TextBlock Text="{Binding Tagline}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{DynamicResource ArtworkTextBrush}"/>
                                <TextBlock Text="{Binding Id}" FontSize="{design:ScaledFontSize 58}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" Margin="-3,3,0,-4"/>
                                <TextBlock Text="{Binding Name}" FontSize="{design:ScaledFontSize 19}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DataContext.SelectedFamilyLatestVersionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{design:ScaledFontSize 11}" Foreground="{DynamicResource ArtworkTextBrush}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Card" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.38"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VersionOption" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="OptionBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GlassBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource CardRaisedBackground}"/><Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="OptionBorder" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LoaderChip" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource CardRaisedBackground}"/><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chip" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Root" Margin="28" ClipToBounds="True">
        <Grid x:Name="BrowseLayer" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Home.Eyebrow}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{DynamicResource Home.ChooseVersion}" Style="{StaticResource DisplayTextStyle}" FontSize="{design:ScaledFontSize 34}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,7,0,0"/>
                <TextBlock Text="{DynamicResource Home.ReleaseDescription}" FontSize="{design:ScaledFontSize 13}" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" MinHeight="132" MaxHeight="190" Margin="0,14,0,8" CornerRadius="22" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Background="{DynamicResource CardBackground}" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding HeroArtUri}" Stretch="UniformToFill" Opacity="0.32" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D90A0D16" Offset="0"/><GradientStop Color="#990A0D16" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                    <design:ResponsiveTilePanel PreferredTileWidth="280" HorizontalGap="16" VerticalGap="12" Margin="22,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Home.HeroEyebrow}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding HeroTitle}" FontSize="{design:ScaledFontSize 29}" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding HeroSubtitle}" FontSize="{design:ScaledFontSize 12}" Foreground="{DynamicResource ArtworkTextBrush}" Margin="0,4,0,10" TextTrimming="CharacterEllipsis"/>
                            <Button Content="{DynamicResource Home.HeroChooseVersion}" Command="{Binding OpenVersionPickerCommand}" HorizontalAlignment="Left" Padding="13,7"/>
                        </StackPanel>
                        <Button Command="{Binding OpenNewsCommand}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="14,11" HorizontalContentAlignment="Left" VerticalAlignment="Center" ToolTip="{DynamicResource Home.NewsTeaserHelp}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Home.NewsTeaser}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding FeaturedNewsTitle}" FontSize="{design:ScaledFontSize 14}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="44"/>
                                <TextBlock Text="{Binding FeaturedNewsDate}" FontSize="{design:ScaledFontSize 10}" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </design:ResponsiveTilePanel>
                </Grid>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,3,0,6" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="{DynamicResource Home.RefreshManifest}" Command="{Binding RefreshVersionsCommand}" Padding="10,5" Margin="8,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding VersionCatalogStatus}" Foreground="{DynamicResource TextTertiary}" FontSize="{design:ScaledFontSize 9}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="2,4,2,18">
                <Grid>
                <ItemsControl ItemsSource="{Binding Families}" Visibility="{Binding HasVersionFamilies, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,14,0"/></Style></ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate><DataTemplate DataType="vm:MinecraftReleaseFamily">
                        <Button Style="{StaticResource ReleaseCardButton}" Tag="{Binding Accent}" Command="{Binding DataContext.SelectFamilyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="216" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MaxHeight="350" AutomationProperties.Name="{Binding Id}" AutomationProperties.HelpText="{DynamicResource Home.FamilyHelp}"/>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24" Visibility="{Binding HasVersionFamilies, Converter={StaticResource BooleanInverseConverter}}">
                    <TextBlock Text="{DynamicResource Home.NoVersionsTitle}" FontSize="{design:ScaledFontSize 21}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource Home.NoVersionsDescription}" FontSize="{design:ScaledFontSize 12}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,14"/>
                    <Button Content="{DynamicResource Home.RefreshManifest}" Command="{Binding RefreshVersionsCommand}" HorizontalAlignment="Center" Padding="14,8"/>
                </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{DynamicResource Home.ManageInstances}" Command="{Binding OpenInstancesCommand}" Padding="12,8" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid>
                            <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance, Mode=TwoWay}" DisplayMemberPath="DisplayName" MinWidth="120" MaxWidth="210" Padding="7,5" ToolTip="{DynamicResource Home.InstanceHelp}"/>
                            <TextBlock Text="{DynamicResource Home.NoInstanceSelected}" Foreground="{DynamicResource TextTertiary}" FontSize="{design:ScaledFontSize 10}" VerticalAlignment="Center" Margin="9,0,28,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="{Binding HasSelectedInstance, Converter={StaticResource BooleanInverseConverter}}"/>
                        </Grid>
                        <Border Background="{DynamicResource CardRaisedBackground}" BorderBrush="{DynamicResource GlassBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="8,0,0,0">
                            <TextBlock Text="{Binding SelectedVersionSummary}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="125"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" MinWidth="140" Padding="18,10" Margin="10,0,0,0" Background="{DynamicResource AccentBrush}" BorderThickness="0" FontWeight="Bold" AutomationProperties.Name="{DynamicResource Home.LaunchMinecraft}" AutomationProperties.HelpText="{Binding StatusText}">
                        <Grid MinWidth="110" ClipToBounds="True">
                            <ProgressBar Style="{x:Null}" Value="{Binding LaunchProgress}" Maximum="100" Foreground="{DynamicResource AccentTextBrush}" Background="Transparent" Opacity="0.18" IsHitTestVisible="False" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="9" ClipToBounds="True"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="9"/></Border></ControlTemplate></ProgressBar.Template>
                            </ProgressBar>
                            <TextBlock Text="{DynamicResource Home.Play}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" Visibility="{Binding CanPlay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{DynamicResource Home.Preparing}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{DynamicResource Home.Running}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" Visibility="{Binding IsSelectedInstanceRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DetailLayer" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform Y="16"/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{DynamicResource Home.Back}" Command="{Binding GoBackCommand}" Padding="12,8" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding SelectedFamily.Name}" FontSize="{design:ScaledFontSize 23}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedFamily.Id}" FontSize="{design:ScaledFontSize 14}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,2,0,0"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" Margin="0,22,0,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border CornerRadius="26" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24">
                    <Grid ClipToBounds="True">
                        <Grid IsHitTestVisible="False">
                            <Ellipse Width="440" Height="440" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-100,0" Fill="{DynamicResource AccentBrush}" Opacity="0.11"/>
                            <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,170,-145" Fill="{DynamicResource AccentBrush}" Opacity="0.07"/>
                        </Grid>
                        <design:ResponsiveTilePanel PreferredTileWidth="360" HorizontalGap="28" VerticalGap="24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Home.MinecraftVersion}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{DynamicResource Home.ExactVersion}" FontSize="{design:ScaledFontSize 21}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,5,0,14"/>
                    <ListBox x:Name="ExactVersionList" ItemsSource="{Binding ExactVersions}" SelectedValuePath="Id" SelectedValue="{Binding SelectedVersion, Mode=TwoWay}" ItemContainerStyle="{StaticResource VersionOption}" Background="Transparent" BorderThickness="0" MaxHeight="360">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="7,3" Margin="0,0,5,0" Visibility="{Binding IsLatest, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource Home.Version.Latest}" FontSize="{design:ScaledFontSize 8}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
                                        </Border>
                                        <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="8" Padding="7,3" Margin="0,0,5,0" Visibility="{Binding IsSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource Home.Version.Snapshot}" FontSize="{design:ScaledFontSize 8}" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource CardRaisedBackground}" CornerRadius="8" Padding="7,3" Visibility="{Binding IsLegacy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontSize="{design:ScaledFontSize 8}" Foreground="{DynamicResource TextSecondary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding ChannelLabel}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Channel}" Value="old_alpha"><Setter Property="Text" Value="{DynamicResource Home.Channel.OldAlpha}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Channel}" Value="old_beta"><Setter Property="Text" Value="{DynamicResource Home.Channel.OldBeta}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Id}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Home.Instance}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <ComboBox ItemsSource="{Binding Instances}"
                              SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Background="{DynamicResource CardBackground}"
                              Foreground="{StaticResource TextPrimary}"
                              BorderBrush="{DynamicResource GlassBorderBrush}"
                              Padding="8,6"
                              Margin="0,7,0,12"
                              ToolTip="{DynamicResource Home.InstanceHelp}"/>
                    <TextBlock Text="{DynamicResource Home.Launch}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{DynamicResource Home.ChooseLoader}" FontSize="{design:ScaledFontSize 21}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,5,0,18"/>
                    <ListBox ItemsSource="{Binding LoaderOptions}" SelectedValuePath="Id" SelectedValue="{Binding SelectedLoader, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionMode="Single">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource LoaderChip}"><Setter Property="IsEnabled" Value="{Binding IsAvailable}"/><Setter Property="ToolTip" Value="{Binding AvailabilityMessage}"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextSecondary}" FontSize="{design:ScaledFontSize 9}" Margin="6,1,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding LoaderCatalogStatus}" Foreground="{StaticResource TextSecondary}" FontSize="{design:ScaledFontSize 11}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedVersionSummary}" Foreground="{StaticResource TextSecondary}" Margin="0,20,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                        </design:ResponsiveTilePanel>
                    </Grid>
                </Border>
            </ScrollViewer>
            <design:ResponsiveTilePanel Grid.Row="2" PreferredTileWidth="320" HorizontalGap="16" VerticalGap="12">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <StackPanel>
                    <Button Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" MinWidth="180" Padding="25,16" Background="{DynamicResource AccentBrush}" BorderThickness="0" FontSize="{design:ScaledFontSize 16}" FontWeight="Bold" AutomationProperties.Name="{DynamicResource Home.LaunchMinecraft}" AutomationProperties.HelpText="{Binding StatusText}">
                        <Button.Content><Grid MinWidth="130" ClipToBounds="True">
                            <ProgressBar Style="{x:Null}" Value="{Binding LaunchProgress}" Maximum="100" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="{DynamicResource AccentTextBrush}" Background="Transparent" Opacity="0.14" IsHitTestVisible="False" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="9" ClipToBounds="True">
                                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="9"/>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <TextBlock Text="{DynamicResource Home.Play}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" Visibility="{Binding CanPlay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{DynamicResource Home.Preparing}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{DynamicResource Home.Running}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" Visibility="{Binding IsSelectedInstanceRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid></Button.Content>
                    </Button>
                    <Button Content="{DynamicResource Home.Cancel}" Command="{Binding CancelLaunchCommand}" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </design:ResponsiveTilePanel>
        </Grid>
    </Grid>
</UserControl>
