<UserControl x:Class="SubReel.Launcher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Настройки" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Оформление, версия приложения и обновления." FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,24"/>
            <Border Style="{StaticResource CardStyle}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Оформление окна" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Подложка Windows 11 или сплошной фон на совместимых системах." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <ComboBox ItemsSource="{Binding BackdropOptions}" SelectedItem="{Binding SelectedWindowBackdrop, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left"/>
                    <CheckBox Content="Меньше анимаций" IsChecked="{Binding ReduceAnimations, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,0"/>
                    <CheckBox Content="Показывать снапшоты Minecraft" IsChecked="{Binding IncludeSnapshots, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                    <TextBlock Text="Язык каталога" Foreground="{DynamicResource TextSecondary}" Margin="0,14,0,5"/>
                    <ComboBox ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding CatalogLanguageStatus}" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Перевод описаний модпаков" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="На русском каталог переводится автоматически. На английском показывается оригинал. Для перевода описаний нужен ключ DeepL API Free; он хранится локально и отправляется DeepL только при поиске." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="Как получить ключ: 1) " Foreground="{DynamicResource TextSecondary}"/>
                        <Hyperlink NavigateUri="https://www.deepl.com/pro-api" RequestNavigate="OpenDeepL_Click">откройте планы DeepL API</Hyperlink>
                        <Run Text="; 2) выберите API Free и зарегистрируйтесь; 3) откройте API Keys &amp; Limits, скопируйте ключ и вставьте ниже. Для API может потребоваться отдельная регистрация, даже если у вас есть аккаунт переводчика DeepL." Foreground="{DynamicResource TextSecondary}"/>
                    </TextBlock>
                    <PasswordBox x:Name="TranslationKeyBox" Width="360" HorizontalAlignment="Left" Padding="10,8" ToolTip="DeepL API key"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Сохранить ключ" Click="SaveTranslationKey_Click" Padding="12,8" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                        <Button Content="Удалить ключ" Command="{Binding RemoveTranslationKeyCommand}" Padding="12,8" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TranslationKeyStatus}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Обновления лаунчера" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Текущая версия" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,4"/>
                    <TextBlock Text="{Binding CurrentVersion}" Foreground="{DynamicResource TextPrimary}" FontSize="16"/>
                    <TextBlock Text="{Binding UpdateSetupStatus}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Проверить обновления" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding CanCheckForUpdates}" Padding="14,10" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                        <Button Content="Скачать и перезапустить" Command="{Binding DownloadAndRestartCommand}" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="14,10" Margin="10,0,0,0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="5" Margin="0,18,0,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
