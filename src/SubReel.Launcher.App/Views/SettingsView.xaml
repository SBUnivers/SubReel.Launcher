<UserControl x:Class="SubReel.Launcher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:design="clr-namespace:SubReel.Launcher.App.DesignSystem" xmlns:components="clr-namespace:SubReel.Launcher.App.Views.Components">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="{DynamicResource Settings.Title}" Style="{StaticResource DisplayTextStyle}" FontSize="{design:ScaledFontSize 30}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{DynamicResource Settings.Subtitle}" FontSize="{design:ScaledFontSize 14}" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,24"/>
            <Border Style="{StaticResource CardStyle}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Launch}" FontSize="{design:ScaledFontSize 20}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Settings.LaunchDescription}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <TextBlock Text="{DynamicResource Settings.Memory}" Foreground="{DynamicResource TextSecondary}"/>
                    <components:MemoryAllocationControl Value="{Binding DefaultMemoryMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        AutomationLabel="{DynamicResource Settings.MemoryAutomation}"
                                                        Margin="0,8,0,0"/>
                    <DockPanel Margin="0,4,0,0"><TextBlock Text="{Binding DefaultMemoryMb, StringFormat={}{0:0}}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{DynamicResource Memory.Mb}" Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,0"/></DockPanel>
                    <TextBlock Text="{DynamicResource Settings.JavaPath}" Foreground="{DynamicResource TextSecondary}" Margin="0,16,0,6"/>
                    <DockPanel LastChildFill="True">
                        <Button Content="{DynamicResource Settings.Browse}" DockPanel.Dock="Right" Click="BrowseJavaPath_Click" Padding="12,7" Margin="8,0,0,0"/>
                        <TextBox x:Name="JavaPathBox" Text="{Binding JavaPathInput, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="{DynamicResource Settings.TestJava}" Command="{Binding InspectJavaCommand}" Padding="14,9" Margin="0,0,8,8"/>
                        <Button Content="{DynamicResource Settings.SaveLaunch}" Command="{Binding SaveLaunchSettingsCommand}" Padding="14,9" Margin="0,0,8,8" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding LaunchSettingsStatus}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Appearance}" FontSize="{design:ScaledFontSize 20}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Settings.BackdropDescription}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <ComboBox ItemsSource="{Binding BackdropOptions}" SelectedItem="{Binding SelectedWindowBackdrop, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource Settings.TextScale}" Foreground="{DynamicResource TextSecondary}" Margin="0,14,0,5"/>
                    <ComboBox ItemsSource="{Binding TextScaleOptions}" DisplayMemberPath="Label" SelectedValuePath="Factor" SelectedValue="{Binding SelectedTextScale, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left"/>
                    <CheckBox Content="{DynamicResource Settings.ReducedMotion}" IsChecked="{Binding ReduceAnimations, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,0"/>
                    <CheckBox Content="{DynamicResource Settings.Snapshots}" IsChecked="{Binding IncludeSnapshots, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                    <CheckBox Content="{DynamicResource Settings.Legacy}" IsChecked="{Binding IncludeLegacyVersions, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                    <TextBlock Text="{DynamicResource Settings.Language}" Foreground="{DynamicResource TextSecondary}" Margin="0,14,0,5"/>
                    <ComboBox ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding CatalogLanguageStatus}" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.TranslationTitle}" FontSize="{design:ScaledFontSize 20}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Settings.TranslationDescription}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Platform}" FontSize="{design:ScaledFontSize 20}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Settings.PlatformDescription}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <Button Content="{DynamicResource Settings.CheckConnection}" Command="{Binding CheckPlatformHealthCommand}" Padding="14,10" HorizontalAlignment="Left" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"/>
                    <TextBlock Text="{Binding PlatformHealthStatus}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Diagnostics}" FontSize="{design:ScaledFontSize 20}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Settings.DiagnosticsDescription}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <WrapPanel>
                        <Button Content="{DynamicResource Settings.CreateArchive}" Command="{Binding CreateDiagnosticBundleCommand}" Padding="14,10" Margin="0,0,8,0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"/>
                        <Button Content="{DynamicResource Settings.OpenLogs}" Command="{Binding OpenLogsFolderCommand}" Padding="14,10" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding DiagnosticStatus}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Updates}" FontSize="{design:ScaledFontSize 20}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Settings.CurrentVersion}" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,4"/>
                    <TextBlock Text="{Binding CurrentVersion}" Foreground="{DynamicResource TextPrimary}" FontSize="{design:ScaledFontSize 16}"/>
                    <TextBlock Text="{Binding UpdateSetupStatus}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <WrapPanel Margin="0,20,0,0">
                        <Button Content="{DynamicResource Settings.CheckUpdates}" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding CanCheckForUpdates}" Padding="14,10" Margin="0,0,10,8" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0"/>
                        <Button Content="{DynamicResource Settings.DownloadRestart}" Command="{Binding DownloadAndRestartCommand}" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="14,10" Margin="0,0,10,8" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"/>
                    </WrapPanel>
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="5" Margin="0,18,0,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
