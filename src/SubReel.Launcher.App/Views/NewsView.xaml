<UserControl x:Class="SubReel.Launcher.App.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SubReel.Launcher.App.Views"
             xmlns:design="clr-namespace:SubReel.Launcher.App.DesignSystem">
    <UserControl.Resources>
        <views:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid x:Name="NewsLayer" Margin="28" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Content="↻" Command="{Binding RefreshCommand}" Padding="12,8" ToolTip="Обновить новости"/>
                <StackPanel><TextBlock Text="ЛЕНТА SUBREEL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Новости и обновления" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,5,0,0"/></StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Command="{Binding OpenArticleCommand}" CommandParameter="{Binding FeaturedRelease}" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" Visibility="{Binding FeaturedRelease, Converter={StaticResource NullToVisibilityConverter}}">
                        <Border CornerRadius="24" BorderBrush="#35FFFFFF" BorderThickness="1" ClipToBounds="True" MinHeight="230" Background="{DynamicResource CardRaisedBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource AccentBrush}" Opacity="0.20"/>
                                <Ellipse Grid.Column="1" Width="350" Height="350" Fill="{DynamicResource AccentBrush}" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,-60,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding FeaturedRelease.Version}" FontSize="88" FontWeight="Black" Foreground="#22FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="28">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="СВЕЖЕЕ ОБНОВЛЕНИЕ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="7,2" Margin="10,0,0,0" Visibility="{Binding FeaturedRelease.IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="НОВОЕ" FontSize="8" Foreground="#100D19" FontWeight="Bold"/></Border></StackPanel>
                                    <TextBlock Text="{Binding FeaturedRelease.Title}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding FeaturedRelease.Summary}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" TextWrapping="Wrap" MaxHeight="58"/>
                                    <TextBlock Text="{Binding FeaturedRelease.DateLabel}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                    <TextBlock Text="Последние публикации" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,24,0,12"/>
                    <ItemsControl ItemsSource="{Binding OtherReleases}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><design:ResponsiveTilePanel PreferredTileWidth="300" HorizontalGap="14" VerticalGap="14"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Background="Transparent" BorderThickness="0" MinHeight="220" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="95"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid ClipToBounds="True"><Border Background="{DynamicResource AccentBrush}" Opacity="0.2"/><Ellipse Width="160" Height="160" Fill="{DynamicResource AccentBrush}" Opacity="0.12" HorizontalAlignment="Right" Margin="0,-65,-28,0"/><TextBlock Text="{Binding Version}" FontSize="48" FontWeight="Black" Foreground="#25FFFFFF" VerticalAlignment="Center" Margin="18,0"/></Grid>
                                        <StackPanel Grid.Row="1" Margin="16,12">
                                            <DockPanel><Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="6,2" DockPanel.Dock="Right" Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="НОВОЕ" FontSize="8" Foreground="#100D19" FontWeight="Bold"/></Border><TextBlock Text="{Binding ChannelLabel}" FontSize="9" Foreground="{DynamicResource AccentBrush}"/></DockPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ReaderLayer" Margin="28" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform Y="14"/></Grid.RenderTransform>
            <Border Background="#D812111B" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="24" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel><Button DockPanel.Dock="Left" Content="← Назад к новостям" Command="{Binding CloseArticleCommand}"/><TextBlock Text="ЧИТАЛКА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxWidth="760" HorizontalAlignment="Center" Margin="0,28">
                        <StackPanel>
                            <Border Height="210" CornerRadius="18" Background="{DynamicResource AccentBrush}" Opacity="0.5"><Grid><TextBlock Text="{Binding SelectedRelease.Version}" FontSize="100" FontWeight="Black" Foreground="#35FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><TextBlock Text="{Binding SelectedRelease.ChannelLabel}" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text=" · " Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding SelectedRelease.DateLabel}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text=" · " Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding SelectedRelease.Version}" Foreground="{DynamicResource TextSecondary}"/></StackPanel>
                            <TextBlock Text="{Binding SelectedRelease.Title}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedRelease.Summary}" FontSize="15" LineHeight="25" Foreground="{DynamicResource TextPrimary}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Что изменилось" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,26,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedRelease.ChangeNotes}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,7"><TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="{Binding}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Открыть релиз на GitHub" Command="{Binding OpenReleaseCommand}" CommandParameter="{Binding SelectedRelease.GitHubReleaseUrl}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
