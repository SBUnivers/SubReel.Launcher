<UserControl x:Class="SubReel.Launcher.App.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SubReel.Launcher.App.Views"
             xmlns:components="clr-namespace:SubReel.Launcher.App.Views.Components"
             xmlns:design="clr-namespace:SubReel.Launcher.App.DesignSystem">
    <UserControl.Resources>
        <views:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid x:Name="NewsLayer" Margin="28" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Padding="12,8" ToolTip="{DynamicResource News.Refresh}" AutomationProperties.Name="{DynamicResource News.Refresh}"><Path Data="{StaticResource IconRefreshGeometry}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
                <StackPanel><TextBlock Text="{DynamicResource News.Eyebrow}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{DynamicResource News.Title}" Style="{StaticResource DisplayTextStyle}" FontSize="{design:ScaledFontSize 30}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,5,0,0"/></StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <components:EmptyStateCard Title="{DynamicResource News.EmptyTitle}"
                                               Message="{Binding StatusText}"
                                               IconKey="news"
                                               MaxWidth="620"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Command="{Binding OpenArticleCommand}" CommandParameter="{Binding FeaturedRelease}" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" Visibility="{Binding FeaturedRelease, Converter={StaticResource NullToVisibilityConverter}}" AutomationProperties.Name="{Binding FeaturedRelease.Title}" AutomationProperties.HelpText="{DynamicResource News.OpenFeatured}">
                        <Border CornerRadius="24" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" ClipToBounds="True" MinHeight="230" Background="{DynamicResource CardRaisedBackground}">
                            <Grid x:Name="FeaturedCardGrid" SizeChanged="OnFeaturedCardSizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                                <Border x:Name="FeaturedTint" Grid.ColumnSpan="2" Background="{DynamicResource AccentBrush}" Opacity="0.20"/>
                                <Image x:Name="FeaturedImage" Grid.ColumnSpan="2" Source="{Binding FeaturedRelease.CoverUrl}" Stretch="UniformToFill" Opacity="0.28" IsHitTestVisible="False"/>
                                <Ellipse x:Name="FeaturedArtGlow" Grid.Column="1" Width="350" Height="350" Fill="{DynamicResource AccentBrush}" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,-60,0"/>
                                <TextBlock x:Name="FeaturedVersionArt" Grid.Column="1" Text="{Binding FeaturedRelease.Version}" FontSize="{design:ScaledFontSize 88}" FontWeight="Black" Foreground="{DynamicResource ArtworkHighlightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel x:Name="FeaturedTextPanel" Grid.Column="0" VerticalAlignment="Center" Margin="28">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FeaturedRelease.NewsTagLabel}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="7,2" Margin="10,0,0,0" Visibility="{Binding FeaturedRelease.IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{DynamicResource News.New}" FontSize="{design:ScaledFontSize 8}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/></Border></StackPanel>
                                    <TextBlock Text="{Binding FeaturedRelease.Title}" FontSize="{design:ScaledFontSize 25}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding FeaturedRelease.Summary}" FontSize="{design:ScaledFontSize 13}" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding FeaturedRelease.DateLabel}" FontSize="{design:ScaledFontSize 11}" Foreground="{DynamicResource TextSecondary}" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                    <TextBlock Text="{DynamicResource News.Latest}" FontSize="{design:ScaledFontSize 17}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,24,0,12"/>
                    <ItemsControl ItemsSource="{Binding OtherReleases}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><design:ResponsiveTilePanel PreferredTileWidth="300" HorizontalGap="14" VerticalGap="14"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Background="Transparent" BorderThickness="0" MinHeight="220" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{DynamicResource News.OpenArticle}">
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="95"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid ClipToBounds="True"><Border Background="{DynamicResource AccentBrush}" Opacity="0.2"/><Image Source="{Binding CoverUrl}" Stretch="UniformToFill" Opacity="0.32" IsHitTestVisible="False"/><Ellipse Width="160" Height="160" Fill="{DynamicResource AccentBrush}" Opacity="0.12" HorizontalAlignment="Right" Margin="0,-65,-28,0"/><TextBlock Text="{Binding Version}" FontSize="{design:ScaledFontSize 48}" FontWeight="Black" Foreground="{DynamicResource ArtworkHighlightBrush}" VerticalAlignment="Center" Margin="18,0"/></Grid>
                                        <StackPanel Grid.Row="1" Margin="16,12">
                                            <DockPanel><Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="6,2" DockPanel.Dock="Right" Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{DynamicResource News.New}" FontSize="{design:ScaledFontSize 8}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/></Border><TextBlock Text="{Binding NewsTagLabel}" FontSize="{design:ScaledFontSize 9}" Foreground="{DynamicResource AccentBrush}"/></DockPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="{design:ScaledFontSize 15}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DateLabel}" FontSize="{design:ScaledFontSize 10}" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ReaderLayer" Margin="28" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform Y="14"/></Grid.RenderTransform>
            <Border Background="{DynamicResource ArtworkScrimBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="24" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel><Button DockPanel.Dock="Left" Content="{DynamicResource News.Back}" Command="{Binding CloseArticleCommand}"/><TextBlock Text="{DynamicResource News.Reader}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxWidth="760" HorizontalAlignment="Center" Margin="0,28">
                        <StackPanel>
                            <Border Height="210" CornerRadius="18" Background="{DynamicResource AccentBrush}" ClipToBounds="True"><Grid><Image Source="{Binding SelectedRelease.CoverUrl}" Stretch="UniformToFill" Opacity="0.5"/><TextBlock Text="{Binding SelectedRelease.Version}" FontSize="{design:ScaledFontSize 100}" FontWeight="Black" Foreground="{DynamicResource ArtworkHighlightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                            <WrapPanel Margin="0,22,0,0"><TextBlock Text="{Binding SelectedRelease.NewsTagLabel}" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text=" · " Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding SelectedRelease.ChannelLabel}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text=" · " Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding SelectedRelease.DateLabel}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text=" · " Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding SelectedRelease.Version}" Foreground="{DynamicResource TextSecondary}"/></WrapPanel>
                            <TextBlock Text="{Binding SelectedRelease.Title}" FontSize="{design:ScaledFontSize 32}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedRelease.Summary}" FontSize="{design:ScaledFontSize 15}" Foreground="{DynamicResource TextPrimary}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource News.Changes}" FontSize="{design:ScaledFontSize 19}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,26,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedRelease.ChangeNotes}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,7"><Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="4,0,12,0" VerticalAlignment="Center"/><TextBlock Text="{Binding}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right"><Button Content="{DynamicResource News.OpenGithub}" Command="{Binding OpenReleaseCommand}" CommandParameter="{Binding SelectedRelease.GitHubReleaseUrl}"/></WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
