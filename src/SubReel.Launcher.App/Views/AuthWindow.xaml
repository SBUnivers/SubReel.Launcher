<Window x:Class="SubReel.Launcher.App.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Auth.Title}" Width="900" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" xmlns:design="clr-namespace:SubReel.Launcher.App.DesignSystem">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="{DynamicResource SurfaceColor}"/>
        <SolidColorBrush x:Key="PanelRaised" Color="{DynamicResource SurfaceRaisedColor}"/>
        <SolidColorBrush x:Key="Line" Color="{DynamicResource BorderColor}"/>
        <SolidColorBrush x:Key="Muted" Color="{DynamicResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}"/>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="{design:ScaledFontSize 14}"/><Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="{design:ScaledFontSize 14}"/><Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="14,6"/><Setter Property="FontSize" Value="{design:ScaledFontSize 14}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{StaticResource PanelRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="{design:ScaledFontSize 13}"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="7,7,0,0">
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentMutedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardRaisedBackground}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Auth.Eyebrow}" FontSize="{design:ScaledFontSize 11}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="{DynamicResource Auth.Heading}" FontSize="{design:ScaledFontSize 29}" FontWeight="SemiBold" Margin="0,7,0,5"/>
                <TextBlock Text="{DynamicResource Auth.Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Width="58" Height="58" CornerRadius="18" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock Text="SR" FontSize="{design:ScaledFontSize 20}" FontWeight="Black" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentMutedBrush}" Margin="0,0,12,0">
                    <Path Data="{StaticResource IconCheckGeometry}" Width="19" Height="19" Fill="Transparent" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Auth.TwoAccounts}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Auth.TwoAccountsDescription}" Foreground="{StaticResource Muted}" FontSize="{design:ScaledFontSize 12}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{DynamicResource Auth.Refresh}" Width="100" Click="Refresh_Click" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="0">
            <TabItem Header="{DynamicResource Auth.SubReelTab}">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="0,12,12,12" Padding="24" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentMutedBrush}" Margin="0,0,13,0"><Path Data="{StaticResource IconAccountGeometry}" Width="23" Height="23" Fill="Transparent" Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Auth.SubReelAccount}" FontSize="{design:ScaledFontSize 18}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Auth.SubReelDescription}" FontSize="{design:ScaledFontSize 12}" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                        </StackPanel>
                        <Grid x:Name="AuthCredentialsGrid" Grid.Row="1" Margin="0,0,0,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Auth.Email}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="EmailBox"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{DynamicResource Auth.Password}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><PasswordBox x:Name="PasswordBox"/></StackPanel>
                        </Grid>
                        <TextBlock x:Name="AuthHintText" Grid.Row="2" Text="{DynamicResource Auth.EmailHint}" Foreground="{StaticResource Muted}" FontSize="{design:ScaledFontSize 12}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Grid x:Name="AuthActionsGrid" Grid.Row="3">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="SignInButton" Content="{DynamicResource Auth.SignIn}" Background="{StaticResource Accent}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" Click="SignIn_Click" Margin="0,0,6,0"/>
                            <Button x:Name="SignUpButton" Grid.Column="1" Content="{DynamicResource Auth.SignUp}" Click="SignUp_Click" Margin="6,0"/>
                            <Button x:Name="SignOutButton" Grid.Column="2" Content="{DynamicResource Auth.SignOut}" Click="SignOut_Click" IsEnabled="False" Margin="6,0,0,0"/>
                            <Button x:Name="BrowserSignInButton" Grid.Row="1" Grid.ColumnSpan="3" Content="{DynamicResource Auth.SignInWebsite}" Click="BrowserSignIn_Click" Margin="0,10,0,0"/>
                        </Grid>
                        <Border Grid.Row="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,20,0,0" VerticalAlignment="Top">
                            <StackPanel><TextBlock x:Name="PlatformStatusTitle" Text="{DynamicResource Auth.AccountStatus}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock x:Name="PlatformStatusDetails" Text="{DynamicResource Auth.AccountStatusHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="{DynamicResource Auth.MinecraftJavaTab}">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="0,12,12,12" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource SuccessMutedBrush}" Margin="0,0,13,0"><TextBlock Text="M" FontSize="{design:ScaledFontSize 24}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Auth.GameProfile}" FontSize="{design:ScaledFontSize 18}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Auth.GameProfileDescription}" FontSize="{design:ScaledFontSize 12}" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Auth.ChooseGameAccount}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                        <ComboBox x:Name="GameAccountBox" Grid.Row="2" Height="42" DisplayMemberPath="Username" SelectionChanged="GameAccountBox_SelectionChanged" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{StaticResource Line}" Padding="10,7"/>
                        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                            <Button x:Name="MicrosoftButton" Content="{DynamicResource Auth.SignInMicrosoft}" Click="Microsoft_Click" Background="{DynamicResource CardRaisedBackground}" Margin="0,0,8,8"/>
                            <Button x:Name="LicenseCheckButton" Content="{DynamicResource Auth.CheckLicense}" Click="LicenseCheck_Click" Margin="0,0,8,8"/>
                            <Button x:Name="BuyMinecraftButton" Content="{DynamicResource Auth.BuyMinecraft}" Click="BuyMinecraft_Click" Margin="0,0,8,8"/>
                            <Button x:Name="OfflineButton" Content="{DynamicResource Auth.AddOffline}" Click="Offline_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <ScrollViewer Grid.Row="4" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border x:Name="LicenseStatusBorder" Background="{DynamicResource CardRaisedBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border x:Name="LicenseStatusIconBackground" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource CardBackground}" VerticalAlignment="Top" Margin="0,0,13,0">
                                            <Path x:Name="LicenseStatusIcon" Data="{StaticResource IconPendingGeometry}" Width="24" Height="24" Fill="Transparent" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Auth.MinecraftLicense}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                            <TextBlock x:Name="LicenseStatusTitle" Text="{DynamicResource Auth.NotChecked}" FontSize="{design:ScaledFontSize 18}" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock x:Name="LicenseStatusDetails" Text="{DynamicResource Auth.CheckLicenseHint}" FontSize="{design:ScaledFontSize 12}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Auth.ProfileLink}" FontSize="{design:ScaledFontSize 10}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                        <TextBlock x:Name="GameProfileText" Text="{DynamicResource Auth.NoGameProfile}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                        <ListBox x:Name="LinkedProfilesList" MinHeight="48" MaxHeight="130" Margin="0,0,0,12"
                                                 Background="{StaticResource CardRaisedBackground}" Foreground="{DynamicResource TextPrimary}"
                                                 BorderBrush="{DynamicResource BorderBrush}" SelectionMode="Single">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="3">
                                                        <TextBlock Text="{Binding MinecraftUsername}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding MinecraftUuid}" FontSize="{design:ScaledFontSize 10}" Foreground="{StaticResource Muted}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button x:Name="LinkButton" Content="{DynamicResource Auth.LinkProfile}" Click="Link_Click" Background="{StaticResource Accent}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" Margin="0,0,5,0"/>
                                            <Button x:Name="UnlinkButton" Grid.Column="1" Content="{DynamicResource Auth.UnlinkProfile}" Click="Unlink_Click" Margin="5,0,0,0" IsEnabled="False"/>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Auth.LinkExplanation}" Foreground="{StaticResource Muted}" FontSize="{design:ScaledFontSize 11}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="{DynamicResource Auth.Ready}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,18,0"/>
            <Button Grid.Column="1" Content="{DynamicResource Auth.Close}" Width="110" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
