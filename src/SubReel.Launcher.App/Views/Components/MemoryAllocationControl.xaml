<UserControl x:Class="SubReel.Launcher.App.Views.Components.MemoryAllocationControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Slider Minimum="512" Maximum="32768" TickFrequency="512"
                IsSnapToTickEnabled="True"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{Binding AutomationLabel, ElementName=Root}"
                ToolTip="{DynamicResource Memory.Tooltip}"
                Margin="0,0,0,2"/>
        <DockPanel>
            <TextBlock Text="{DynamicResource Memory.Min}" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="{DynamicResource Memory.Max}" Foreground="{DynamicResource TextSecondary}" DockPanel.Dock="Right"/>
        </DockPanel>
    </StackPanel>
</UserControl>
