<UserControl x:Class="SubReel.Launcher.App.Views.Components.InstanceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            Margin="0,0,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F4F5FF"/>
                <TextBlock Text="{Binding MinecraftVersion, StringFormat=Minecraft {0}}"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,5,0,0"/>
                <TextBlock Text="{Binding LoaderType}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="11"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding FavoriteCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    ToolTip="Переключить избранное"
                    VerticalAlignment="Center"
                    Padding="8,5">
                <TextBlock Text="☆" FontSize="18">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="☆"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Text" Value="★"/>
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </Grid>
    </Border>
</UserControl>
