<UserControl x:Class="SubReel.Launcher.App.Views.Components.InstanceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" xmlns:design="clr-namespace:SubReel.Launcher.App.DesignSystem">
    <Border x:Name="CardBorder" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            Margin="0,0,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Name}"
                           FontSize="{design:ScaledFontSize 15}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0">
                    <Run Text="{DynamicResource InstanceCard.MinecraftVersionPrefix}"/>
                    <Run Text="{Binding MinecraftVersion}"/>
                </TextBlock>
                <TextBlock Text="{Binding LoaderType}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="{design:ScaledFontSize 11}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding FavoriteCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    ToolTip="{DynamicResource InstanceCard.FavoriteTooltip}"
                    AutomationProperties.Name="{DynamicResource InstanceCard.FavoriteName}"
                    AutomationProperties.HelpText="{DynamicResource InstanceCard.FavoriteHelp}"
                    VerticalAlignment="Center"
                    Padding="8,5">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Path Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="{StaticResource IconFavoriteOutlineGeometry}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconFavoriteOutlineGeometry}"/>
                            <Setter Property="Fill" Value="Transparent"/>
                            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconFavoriteFilledGeometry}"/>
                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Button>
        </Grid>
    </Border>
</UserControl>
