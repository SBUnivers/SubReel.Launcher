<Window x:Class="SubReel.Launcher.App.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubReel Launcher" Width="520" Height="650" MinWidth="520" MinHeight="650"
        ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#111019"
        Foreground="#F4F1FC" ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="SetupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9A4B9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="SetupChoice" TargetType="ComboBox">
            <Setter Property="Background" Value="#201E2B"/>
            <Setter Property="Foreground" Value="#F4F1FC"/>
            <Setter Property="BorderBrush" Value="#393545"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" Margin="0,12,0,28">
            <Border Width="58" Height="58" CornerRadius="19" Background="#8875FF" HorizontalAlignment="Center">
                <TextBlock Text="S" FontSize="34" FontWeight="Black" Foreground="#171323"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="SubReel" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock x:Name="SubtitleText" Text="Подготавливаем лаунчер к запуску" FontSize="13"
                       Foreground="#A9A4B9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel x:Name="ChecksPanel" VerticalAlignment="Top">
                <TextBlock Text="Проверка запуска" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <Border Background="#191722" BorderBrush="#302D3B" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="FilesIcon" Text="…" FontSize="17" Foreground="#A9A4B9" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Файлы лаунчера" FontWeight="SemiBold"/><TextBlock x:Name="FilesStatus" Text="Ожидание проверки" Foreground="#A9A4B9" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <Border Background="#191722" BorderBrush="#302D3B" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LicenseIcon" Text="…" FontSize="17" Foreground="#A9A4B9" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Minecraft Java Edition" FontWeight="SemiBold"/><TextBlock x:Name="LicenseStatus" Text="Ожидание проверки" Foreground="#A9A4B9" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <Border Background="#191722" BorderBrush="#302D3B" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SubReelIcon" Text="…" FontSize="17" Foreground="#A9A4B9" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Аккаунт SubReel" FontWeight="SemiBold"/><TextBlock x:Name="SubReelStatus" Text="Ожидание проверки" Foreground="#A9A4B9" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <Button x:Name="LoginButton" Content="Войти или обновить сессию SubReel" Click="Login_Click"
                        Visibility="Collapsed" Margin="0,8,0,0" Padding="12,10" Background="#252233"
                        Foreground="#E9E4FF" BorderBrush="#51476F"/>
            </StackPanel>

            <StackPanel x:Name="WelcomePanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="Настроим лаунчер" FontSize="23" FontWeight="Bold"/>
                <TextBlock Text="Эти параметры можно поменять позже в настройках." Foreground="#A9A4B9" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,10"/>

                <TextBlock Text="Язык" Style="{StaticResource SetupLabel}"/>
                <ComboBox x:Name="LanguageBox" Style="{StaticResource SetupChoice}">
                    <ComboBoxItem Content="Русский" Tag="ru-RU"/>
                    <ComboBoxItem Content="English" Tag="en-US"/>
                </ComboBox>

                <TextBlock Text="Память для игры по умолчанию" Style="{StaticResource SetupLabel}"/>
                <ComboBox x:Name="MemoryBox" Style="{StaticResource SetupChoice}">
                    <ComboBoxItem Content="2 ГБ" Tag="2048"/>
                    <ComboBoxItem Content="4 ГБ" Tag="4096"/>
                    <ComboBoxItem Content="6 ГБ" Tag="6144"/>
                    <ComboBoxItem Content="8 ГБ" Tag="8192"/>
                </ComboBox>

                <CheckBox x:Name="ReduceMotionBox" Content="Уменьшить анимации" Foreground="#D8D4E2" Margin="0,20,0,0"/>
                <TextBlock Text="Лицензия нужна для игры через Microsoft. Офлайн-профиль можно использовать без подтверждения лицензии." Foreground="#89849B" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,22,0,0">
            <ProgressBar x:Name="StartupProgress" Height="3" Minimum="0" Maximum="3" Value="0" Background="#292634" Foreground="#8875FF" BorderThickness="0"/>
            <Button x:Name="ContinueButton" Content="Продолжить" Click="Continue_Click" IsEnabled="False"
                    Padding="14,12" Margin="0,16,0,0" Background="#8875FF" Foreground="#171323"
                    BorderThickness="0" FontWeight="Bold"/>
            <Button x:Name="SkipButton" Content="Пропустить настройку" Click="Skip_Click" Visibility="Collapsed"
                    Padding="8" Margin="0,5,0,0" Background="Transparent" Foreground="#A9A4B9" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
