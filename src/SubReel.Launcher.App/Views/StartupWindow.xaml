<Window x:Class="SubReel.Launcher.App.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubReel Launcher" Width="520" Height="650" MinWidth="420" MinHeight="520"
        ResizeMode="CanResizeWithGrip" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}" ShowInTaskbar="True" xmlns:design="clr-namespace:SubReel.Launcher.App.DesignSystem">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="{design:ScaledFontSize 12}"/>
        </Style>
        <Style x:Key="SetupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="{design:ScaledFontSize 13}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="SetupChoice" TargetType="ComboBox">
            <Setter Property="FontSize" Value="{design:ScaledFontSize 14}"/>
            <Setter Property="Background" Value="{DynamicResource CardRaisedBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" Margin="0,12,0,28">
            <Border Width="58" Height="58" CornerRadius="19" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                <TextBlock Text="S" FontSize="{design:ScaledFontSize 34}" FontWeight="Black" Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="SubReel" FontSize="{design:ScaledFontSize 22}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock x:Name="SubtitleText" Text="{DynamicResource Startup.Preparing}" FontSize="{design:ScaledFontSize 13}"
                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel x:Name="ChecksPanel" VerticalAlignment="Top">
                <TextBlock Text="{DynamicResource Startup.CheckTitle}" FontSize="{design:ScaledFontSize 17}" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path x:Name="FilesIcon" Data="{StaticResource IconPendingGeometry}" Width="18" Height="18" Fill="Transparent" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Startup.Files}" FontWeight="SemiBold"/><TextBlock x:Name="FilesStatus" Text="{DynamicResource Startup.Pending}" Foreground="{DynamicResource TextSecondary}" FontSize="{design:ScaledFontSize 12}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path x:Name="LicenseIcon" Data="{StaticResource IconPendingGeometry}" Width="18" Height="18" Fill="Transparent" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Startup.Minecraft}" FontWeight="SemiBold"/><TextBlock x:Name="LicenseStatus" Text="{DynamicResource Startup.Pending}" Foreground="{DynamicResource TextSecondary}" FontSize="{design:ScaledFontSize 12}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path x:Name="SubReelIcon" Data="{StaticResource IconPendingGeometry}" Width="18" Height="18" Fill="Transparent" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Startup.SubReel}" FontWeight="SemiBold"/><TextBlock x:Name="SubReelStatus" Text="{DynamicResource Startup.Pending}" Foreground="{DynamicResource TextSecondary}" FontSize="{design:ScaledFontSize 12}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <Button x:Name="LoginButton" Content="{DynamicResource Startup.Login}" Click="Login_Click"
                        Visibility="Collapsed" Margin="0,8,0,0" Padding="12,10" Background="{DynamicResource CardRaisedBackground}"
                        Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource AccentBorderBrush}"/>
            </StackPanel>

            <StackPanel x:Name="WelcomePanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="{DynamicResource Startup.SetupTitle}" FontSize="{design:ScaledFontSize 23}" FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Startup.SetupDescription}" Foreground="{DynamicResource TextSecondary}" FontSize="{design:ScaledFontSize 13}" TextWrapping="Wrap" Margin="0,7,0,10"/>

                <TextBlock Text="{DynamicResource Startup.Language}" Style="{StaticResource SetupLabel}"/>
                <ComboBox x:Name="LanguageBox" Style="{StaticResource SetupChoice}">
                    <ComboBoxItem Content="Русский" Tag="ru-RU"/>
                    <ComboBoxItem Content="English" Tag="en-US"/>
                </ComboBox>

                <TextBlock Text="{DynamicResource Startup.DefaultMemory}" Style="{StaticResource SetupLabel}"/>
                <ComboBox x:Name="MemoryBox" Style="{StaticResource SetupChoice}">
                    <ComboBoxItem Content="{DynamicResource Startup.Ram2}" Tag="2048"/>
                    <ComboBoxItem Content="{DynamicResource Startup.Ram4}" Tag="4096"/>
                    <ComboBoxItem Content="{DynamicResource Startup.Ram6}" Tag="6144"/>
                    <ComboBoxItem Content="{DynamicResource Startup.Ram8}" Tag="8192"/>
                </ComboBox>

                <CheckBox x:Name="ReduceMotionBox" Content="{DynamicResource Startup.ReduceMotion}" Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,0"/>
                <TextBlock Text="{DynamicResource Startup.LicenseHint}" Foreground="{DynamicResource TextSecondary}" FontSize="{design:ScaledFontSize 12}" TextWrapping="Wrap" Margin="0,18,0,0"/>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,22,0,0">
            <ProgressBar x:Name="StartupProgress" Height="3" Minimum="0" Maximum="3" Value="0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
            <Button x:Name="ContinueButton" Content="{DynamicResource Startup.Continue}" Click="Continue_Click" IsEnabled="False"
                    Padding="14,12" Margin="0,16,0,0" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                    BorderThickness="0" FontWeight="Bold"/>
            <Button x:Name="SkipButton" Content="{DynamicResource Startup.Skip}" Click="Skip_Click" Visibility="Collapsed"
                    Padding="8" Margin="0,5,0,0" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
