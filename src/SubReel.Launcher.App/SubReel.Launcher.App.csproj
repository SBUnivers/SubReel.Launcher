<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SubReel.Launcher.Abstractions\SubReel.Launcher.Abstractions.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Auth\SubReel.Launcher.Auth.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Core\SubReel.Launcher.Core.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Infrastructure\SubReel.Launcher.Infrastructure.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Rust.Abstractions\SubReel.Launcher.Rust.Abstractions.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Rust.Core\SubReel.Launcher.Rust.Core.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Rust.Infrastructure\SubReel.Launcher.Rust.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="content\version-groups.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>SubReel.Launcher.App.App</StartupObject>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
