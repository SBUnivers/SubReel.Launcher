<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#8875FF</Color>
    <Color x:Key="AccentTextColor">#100D19</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{DynamicResource AccentColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{DynamicResource AccentColor}" Opacity="0.45" />
    <Color x:Key="BackgroundColor">#0B0D14</Color>
    <Color x:Key="SidebarColor">#10131D</Color>
    <Color x:Key="SurfaceColor">#171B29</Color>
    <Color x:Key="SurfaceRaisedColor">#202436</Color>
    <Color x:Key="BorderColor">#292E40</Color>
    <Color x:Key="TextPrimaryColor">#F4F5FF</Color>
    <Color x:Key="TextSecondaryColor">#969CB3</Color>
    <Color x:Key="TextTertiaryColor">#8B90A5</Color>
    <Color x:Key="ErrorColor">#FF6B7A</Color>
    <Color x:Key="SuccessColor">#6EE7A8</Color>
    <Color x:Key="WarningColor">#FFD166</Color>
    <SolidColorBrush x:Key="AppBackground" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{DynamicResource SidebarColor}" />
    <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardRaisedBackground" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiary" Color="{DynamicResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="White" Opacity="0.16" />
    <SolidColorBrush x:Key="GlassBorderSubtleBrush" Color="White" Opacity="0.09" />
    <SolidColorBrush x:Key="ArtworkHighlightBrush" Color="White" Opacity="0.14" />
    <SolidColorBrush x:Key="ArtworkTextBrush" Color="White" Opacity="0.82" />
    <SolidColorBrush x:Key="ArtworkScrimBrush" Color="{DynamicResource BackgroundColor}" Opacity="0.78" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessMutedBrush" Color="{DynamicResource SuccessColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
</ResourceDictionary>
